{
  "fontFamilies": {
    "mono": "\"JetBrains Mono\", \"SF Mono\", \"Fira Code\", Menlo, monospace",
    "monoFallback": "Menlo, monospace",
    "ui": "\"SF Pro Text\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
  },
  "scale": {
    "xs": { "size": 9, "lineHeight": 1.3, "weight": 400 },
    "sm": { "size": 10, "lineHeight": 1.4, "weight": 400 },
    "base": { "size": 11, "lineHeight": 1.5, "weight": 400 },
    "md": { "size": 12, "lineHeight": 1.5, "weight": 500 },
    "lg": { "size": 14, "lineHeight": 1.4, "weight": 600 },
    "xl": { "size": 16, "lineHeight": 1.3, "weight": 600 },
    "2xl": { "size": 20, "lineHeight": 1.2, "weight": 600 },
    "3xl": { "size": 28, "lineHeight": 1.1, "weight": 700 }
  },
  "roles": {
    "micro": "xs",
    "caption": "sm",
    "body": "base",
    "bodyStrong": "md",
    "label": "sm",
    "heading": "lg",
    "headingLarge": "xl",
    "display": "2xl",
    "hero": "3xl",
    "terminal": "base",
    "code": "base"
  }
}